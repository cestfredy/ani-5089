from Jenga import *
import os

NK = os.environ.get("NKENTSEU_ROOT", "C:/tools/Nkentseu").replace("\\", "/")

SOUS_WINDOWS = (os.name == "nt")
SYSTEME = "Windows" if SOUS_WINDOWS else "Linux"
EXTENSION = ".lib" if SOUS_WINDOWS else ".a"

MODULES = [
    ("NKWindow",     "Kernel/Runtime"),
    ("NKEvent",      "Kernel/Runtime"),
    ("NKTime",       "Kernel/System"),
    ("NKFileSystem", "Kernel/System"),
    ("NKLogger",     "Kernel/System"),
    ("NKThreading",  "Kernel/System"),
    ("NKMath",       "Kernel/Foundation"),
    ("NKContainers", "Kernel/Foundation"),
    ("NKMemory",     "Kernel/Foundation"),
    ("NKCore",       "Kernel/Foundation"),
    ("NKPlatform",   "Kernel/Foundation"),
]

def bibliotheques(configuration):
    dossier = f"{NK}/Build/Lib/{configuration}-{SYSTEME}"
    return [f"{dossier}/{nom}{EXTENSION}" for nom, _ in MODULES]

with workspace("MaSalleWks", location="."):
    configurations(["Debug", "Release"])

    with project("MaSalle"):
        windowedapp()
        language("C++")
        cppdialect("C++17")
        location(".")
        files(["main.cpp"])

        objdir("Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
        targetdir("Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

        includedirs([f"{NK}/{dossier}/{nom}/src" for nom, dossier in MODULES])

        defines([f"NKENTSEU_{nom[2:].upper()}_STATIC_LIB" for nom, _ in MODULES])

        for configuration in ["Debug", "Release"]:
            with filter(f"config:{configuration}"):
                links(bibliotheques(configuration))

        with filter("system:Windows"):
            defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
            links(["user32", "gdi32", "opengl32", "dwmapi", "shell32", "comdlg32",
                   "mf", "mfplat", "mfreadwrite", "mfuuid", "uuid", "ole32",
                   "oleaut32", "dinput8", "dxguid", "winmm", "uxtheme", "psapi",
                   "advapi32", "wbemuuid"])

        with filter("system:Linux"):
            defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
            links(["pthread", "X11", "Xrandr", "GL"])
